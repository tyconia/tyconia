                reposition: (0.5, 1.5),
              ),
              CameraMove(
                camera: "main",
                position: (0.5, 1.0),
              ),
            ],
          ),
          Converse(
            character: "bois_of_liberty::frank",
            content: Continue(text: "Heh... c'mon inside, we'll talk proper-like. But I ain't forgettin'."),
          ),
          Converse(
            character: "base::pov_player",
            content: Continue(text: "Appreciate ya Frank. I'll make good on it."),
